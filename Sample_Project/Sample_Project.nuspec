<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Sample_Project</id>
    <version>1.0.0.00</version>
    <title>Flexygo Sample_Project</title>
    <authors>Ahora Freeware</authors>
    <owners>Ahora Freeware</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Create your own Professional Solutions. Flexygo allows you to immediatly build incredible Solutions for companies, professionals and individuals.</description>
    <copyright>Copyright © 2018 Ahora Freeware</copyright>
    <projectUrl>http://flexygo.es</projectUrl>
    <iconUrl>https://nuget.flexygo.com/isotipo.png</iconUrl>
    <releaseNotes/>
    <dependencies>
		<dependency id="Microsoft.Data.SqlClient.SNI" version="5.1.1" />
		<dependency id="Microsoft.Playwright" version="1.31.1" />
    </dependencies>
  </metadata>
  <files>
	<file src="..\..\publish\bin\**\*.*" target="lib\net46\"  exclude="..\..\publish\bin\*Microsoft.Data.SqlClient.SNI.*;..\..\publish\bin\*playwright.ps1*;..\..\publish\bin\.playwright\**\*"/>
    <file src="..\..\publish\**\*.*" target="content\" exclude="..\..\publish\bin\**\*.*;..\..\publish\db\*.dacpac;..\..\publish\nuget\**\*.*;..\..\publish\*playwright.ps1*;..\..\publish\.playwright\**\*"/>    
    <file src="..\..\publish\bin\*Microsoft.Data.SqlClient.SNI.*;..\..\publish\bin\*playwright.ps1*" target="content\bin\" />
	<file src="..\..\publish\bin\.playwright\**\*.*" target="content\bin\.playwright" />
	<!--Project databases--> 
	<file src=".\Sample_ProjectBD\bin\$configuration$\*.dacpac" target="content\db\" />	
    <file src=".\Sample_Project_DataBD\bin\$configuration$\Sample_Project_DataBD.dacpac" target="content\db\" />
	<!--Typescript definitions are included so you can modify/replace our functions--> 
	<file src=".\Sample_Project\Scripts\typings\**\*.d.ts" target="content\Scripts\typings\" />
    <file src=".\Sample_Project\js\flexygo\**\*.d.ts" target="content\js\flexygo\" />
  </files>
  </metadata>
</package>